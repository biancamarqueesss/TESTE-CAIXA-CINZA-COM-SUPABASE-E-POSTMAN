{
  "info": {
    "_postman_id": "7183c945-be5c-49d3-9044-dbf280117899",
    "name": "Supabase Auth - Testes Caixa Cinza",
    "description": "Testes funcionais de caixa cinza do endpoint POST /auth/v1/token?grant_type=password. Requer o environment 'Supabase Auth - Caixa Cinza'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CT01 - Login válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Resposta é JSON', function () { pm.response.to.be.json; });",
              "const j = pm.response.json();",
              "pm.test('Retorna access_token', function () { pm.expect(j.access_token).to.be.a('string').and.not.empty; });",
              "pm.test('token_type é bearer', function () { pm.expect(j.token_type).to.eql('bearer'); });",
              "pm.test('expires_in é numérico', function () { pm.expect(j.expires_in).to.be.a('number'); });",
              "pm.test('Retorna refresh_token', function () { pm.expect(j.refresh_token).to.be.a('string').and.not.empty; });",
              "pm.test('Usuário retornado é o e-mail de teste', function () { pm.expect(j.user.email).to.eql(pm.environment.get('email')); });",
              "pm.test('JWT possui 3 partes e role authenticated', function () {",
              "  const parts = j.access_token.split('.');",
              "  pm.expect(parts.length).to.eql(3);",
              "  let b64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
              "  while (b64.length % 4) { b64 += '='; }",
              "  const payload = JSON.parse(atob(b64));",
              "  pm.expect(payload.role).to.eql('authenticated');",
              "  pm.expect(payload.email).to.eql(pm.environment.get('email'));",
              "});",
              "pm.environment.set('access_token', j.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "description": "Credenciais corretas. Esperado: 200 + access_token."
      },
      "response": []
    },
    {
