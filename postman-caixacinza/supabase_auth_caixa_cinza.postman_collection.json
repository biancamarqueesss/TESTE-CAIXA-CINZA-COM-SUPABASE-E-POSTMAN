      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
              "pm.test('error_code é invalid_credentials', function () { pm.expect(pm.response.json().error_code).to.eql('invalid_credentials'); });",
              "pm.test('Resposta é JSON', function () { pm.response.to.be.json; });",
              "pm.test('Não retorna access_token', function () { pm.expect(pm.response.json()).to.not.have.property('access_token'); });",
              "pm.test('Retorna mensagem de erro', function () {",
              "  const j = pm.response.json();",
              "  pm.expect(j.msg || j.message || j.error_description || j.error).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Tempo de resposta < 3000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });"
            ]
          }
        }
